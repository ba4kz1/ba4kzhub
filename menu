-- Função de validação da chave
local function validateKey(inputKey)
    if not inputKey or inputKey == "" then
        return false, nil, "Chave vazia"
    end

    local success, response = pcall(function()
        local url = "https://keys-65bcf-default-rtdb.firebaseio.com/keys/" .. HttpService:UrlEncode(inputKey) .. ".json"
        local httpResponse = game:HttpGet(url)
        return HttpService:JSONDecode(httpResponse)
    end)

    if not success then
        warn("Key validation failed: " .. tostring(response))
        return false, nil, "Erro de conexão"
    end

    if response == nil then
        return false, nil, "Chave não encontrada"
    end

    if not response.valid then
        return false, nil, "Chave inválida"
    end

    print("Key valid, type: " .. tostring(response.type))
    return true, response.type, nil
end

-- Função de autenticação
local function authenticate(inputKey)
    print("Authenticating with key: " .. tostring(inputKey))
    if not inputKey or inputKey == "" then
        Rayfield:Notify({
            Title = "Erro",
            Content = "Insira uma chave válida.",
            Duration = 5,
            Image = "alert"
        })
        return
    end

    local isValid, authType, errorMsg = validateKey(inputKey)
    if isValid then
        local validTypes = {"normal", "premium", "master"}
        if not table.find(validTypes, authType) then
            Rayfield:Notify({
                Title = "Erro",
                Content = "Tipo de chave desconhecido: " .. tostring(authType),
                Duration = 5,
                Image = "alert"
            })
            print("Unknown key type: " .. tostring(authType))
            return
        end

        isAuthenticated = true
        isPremium = authType == "premium" or authType == "master"
        isMaster = authType == "master"
        Rayfield:Notify({
            Title = "Sucesso",
            Content = authType == "master" and "Bem-vindo ao Ba4kz Hub Master!" or
                      authType == "premium" and "Bem-vindo ao Ba4kz Hub Premium!" or
                      "Bem-vindo ao Ba4kz Hub!",
            Duration = 5,
            Image = "check"
        })
        print("Authentication successful, key type: " .. authType)
        pcall(setclipboard, "https://discord.gg/your-discord")
        pcall(function() Rayfield:Destroy() end)
        loadMainMenu()
    else
        Rayfield:Notify({
            Title = "Erro",
            Content = errorMsg or "Chave inválida.",
            Duration = 5,
            Image = "alert"
        })
        print("Authentication failed: " .. (errorMsg or "Invalid key"))
    end
end

